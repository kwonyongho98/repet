-- 기존에 'other' 타입으로 저장된 케어노트 이벤트를 'care_note'로 변환
UPDATE calendar_events ce
SET event_type = 'care_note',
    related_log_type = 'care_note'
WHERE ce.event_type = 'other'
  AND ce.related_log_id IS NOT NULL
  AND EXISTS (
    SELECT 1 FROM care_notes cn WHERE cn.id = ce.related_log_id
  );
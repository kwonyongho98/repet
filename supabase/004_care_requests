-- ============================================
-- Migration: Care Requests (케어 요청서)
-- 키즈노트 투약의뢰서 벤치마킹
-- ============================================

-- ============================================
-- ENUMS
-- ============================================

DO $$ BEGIN
  CREATE TYPE care_request_type AS ENUM ('medication', 'meal', 'special');
EXCEPTION
  WHEN duplicate_object THEN null;
END $$;

DO $$ BEGIN
  CREATE TYPE care_request_status AS ENUM ('pending', 'confirmed', 'completed', 'cancelled');
EXCEPTION
  WHEN duplicate_object THEN null;
END $$;

DO $$ BEGIN
  CREATE TYPE medication_method AS ENUM ('with_food', 'direct', 'with_water');
EXCEPTION
  WHEN duplicate_object THEN null;
END $$;

-- ============================================
-- TABLES
-- ============================================

-- 케어 요청서 메인 테이블
CREATE TABLE IF NOT EXISTS care_requests (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  
  -- 관계
  pet_id UUID NOT NULL REFERENCES pets(id) ON DELETE CASCADE,
  provider_id UUID NOT NULL REFERENCES service_providers(id) ON DELETE CASCADE,
  family_id UUID NOT NULL REFERENCES families(id) ON DELETE CASCADE,
  requester_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,
  
  -- 요청 정보
  request_type care_request_type NOT NULL,
  date DATE NOT NULL,
  status care_request_status DEFAULT 'pending',
  
  -- 투약 정보 (request_type = 'medication')
  medication_name TEXT,
  medication_timing TEXT[], -- ['morning', 'lunch', 'dinner']
  medication_dosage TEXT,
  medication_method medication_method,
  medication_duration INTEGER, -- 일수
  
  -- 식사 정보 (request_type = 'meal')
  meal_food_type TEXT,
  meal_amount TEXT,
  meal_timing TEXT[], -- ['morning', 'lunch', 'dinner']
  meal_snack_allowed BOOLEAN DEFAULT TRUE,
  meal_allergies TEXT,
  
  -- 특이사항 (request_type = 'special')
  special_tags TEXT[],
  special_description TEXT,
  
  -- 공통
  note TEXT,
  photos TEXT[] DEFAULT ARRAY[]::TEXT[],
  
  -- 확인 정보
  confirmed_at TIMESTAMPTZ,
  confirmed_by UUID REFERENCES profiles(id),
  
  -- 메타
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- ============================================
-- INDEXES
-- ============================================

CREATE INDEX IF NOT EXISTS idx_care_requests_pet ON care_requests(pet_id);
CREATE INDEX IF NOT EXISTS idx_care_requests_provider ON care_requests(provider_id);
CREATE INDEX IF NOT EXISTS idx_care_requests_family ON care_requests(family_id);
CREATE INDEX IF NOT EXISTS idx_care_requests_date ON care_requests(date);
CREATE INDEX IF NOT EXISTS idx_care_requests_status ON care_requests(status);

-- 날짜 범위 조회 최적화
CREATE INDEX IF NOT EXISTS idx_care_requests_date_range 
ON care_requests(provider_id, date, status);

-- ============================================
-- ROW LEVEL SECURITY
-- ============================================

ALTER TABLE care_requests ENABLE ROW LEVEL SECURITY;

-- 가족은 자신의 케어 요청 조회/생성/수정 가능
DROP POLICY IF EXISTS "Family manage care requests" ON care_requests;
CREATE POLICY "Family manage care requests" ON care_requests
  FOR ALL USING (
    family_id IN (SELECT family_id FROM profiles WHERE id = auth.uid())
  );

-- Provider는 연결된 펫의 케어 요청 조회 가능
DROP POLICY IF EXISTS "Provider view care requests" ON care_requests;
CREATE POLICY "Provider view care requests" ON care_requests
  FOR SELECT USING (
    provider_id IN (SELECT id FROM service_providers WHERE owner_id = auth.uid())
  );

-- Provider는 케어 요청 상태 업데이트 가능
DROP POLICY IF EXISTS "Provider update care requests" ON care_requests;
CREATE POLICY "Provider update care requests" ON care_requests
  FOR UPDATE USING (
    provider_id IN (SELECT id FROM service_providers WHERE owner_id = auth.uid())
  );

-- ============================================
-- TRIGGERS
-- ============================================

-- updated_at 자동 업데이트
DROP TRIGGER IF EXISTS update_care_requests_updated_at ON care_requests;
CREATE TRIGGER update_care_requests_updated_at
  BEFORE UPDATE ON care_requests
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

-- ============================================
-- NOTIFICATION FUNCTION
-- ============================================

-- 케어 요청 생성 시 Provider에게 알림
CREATE OR REPLACE FUNCTION notify_care_request()
RETURNS TRIGGER AS $$
DECLARE
  v_pet_name TEXT;
  v_requester_name TEXT;
  v_provider_owner_id UUID;
BEGIN
  -- 펫 이름 조회
  SELECT name INTO v_pet_name FROM pets WHERE id = NEW.pet_id;
  
  -- 요청자 이름 조회
  SELECT name INTO v_requester_name FROM profiles WHERE id = NEW.requester_id;
  
  -- Provider 소유자 ID 조회
  SELECT owner_id INTO v_provider_owner_id 
  FROM service_providers WHERE id = NEW.provider_id;
  
  -- Provider에게 알림 생성
  INSERT INTO notifications (user_id, type, title, body, data)
  VALUES (
    v_provider_owner_id,
    'care_request',
    CASE NEW.request_type
      WHEN 'medication' THEN '💊 투약 요청이 도착했어요'
      WHEN 'meal' THEN '🍽 식사 요청이 도착했어요'
      WHEN 'special' THEN '⚠️ 특이사항 전달이 도착했어요'
    END,
    v_requester_name || '님이 ' || v_pet_name || '의 케어 요청을 보냈습니다.',
    jsonb_build_object(
      'careRequestId', NEW.id,
      'petId', NEW.pet_id,
      'type', NEW.request_type
    )
  );
  
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

DROP TRIGGER IF EXISTS on_care_request_created ON care_requests;
CREATE TRIGGER on_care_request_created
  AFTER INSERT ON care_requests
  FOR EACH ROW
  EXECUTE FUNCTION notify_care_request();

-- 케어 요청 확인 시 가족에게 알림
CREATE OR REPLACE FUNCTION notify_care_request_confirmed()
RETURNS TRIGGER AS $$
DECLARE
  v_pet_name TEXT;
  v_provider_name TEXT;
  v_family_member_id UUID;
BEGIN
  -- 상태가 confirmed로 변경되었을 때만
  IF NEW.status = 'confirmed' AND OLD.status = 'pending' THEN
    -- 펫 이름 조회
    SELECT name INTO v_pet_name FROM pets WHERE id = NEW.pet_id;
    
    -- Provider 이름 조회
    SELECT business_name INTO v_provider_name 
    FROM service_providers WHERE id = NEW.provider_id;
    
    -- 가족 구성원들에게 알림 생성
    FOR v_family_member_id IN 
      SELECT id FROM profiles WHERE family_id = NEW.family_id
    LOOP
      INSERT INTO notifications (user_id, type, title, body, data)
      VALUES (
        v_family_member_id,
        'care_request',
        '✅ 케어 요청이 확인되었어요',
        v_provider_name || '에서 ' || v_pet_name || '의 케어 요청을 확인했습니다.',
        jsonb_build_object(
          'careRequestId', NEW.id,
          'petId', NEW.pet_id,
          'status', NEW.status
        )
      );
    END LOOP;
  END IF;
  
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

DROP TRIGGER IF EXISTS on_care_request_confirmed ON care_requests;
CREATE TRIGGER on_care_request_confirmed
  AFTER UPDATE ON care_requests
  FOR EACH ROW
  EXECUTE FUNCTION notify_care_request_confirmed();
